<?xml version="1.0" encoding="utf-8"?>
<!-- 런처 아이콘 포그라운드: 전원(종료) 심볼. 배경은 ic_launcher_background(딥레드) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 링 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M28,56 A26,26 0 1,0 80,56 A26,26 0 1,0 28,56"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- 링 윗부분을 배경색으로 지워서 전원 심볼의 틈 만들기 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,20 L54,40"
        android:strokeWidth="12"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeLineCap="butt" />
    <!-- 전원 다리 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32 L54,60"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
